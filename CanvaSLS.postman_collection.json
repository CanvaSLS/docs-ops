      "item": [
        {
          "name": "Entrar como profe (UTEC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{urlAuth}}/auth/login",
              "host": [
                "{{urlAuth}}/auth/login"
              ]
            },
            "description": "Guarda {{token}} y lo aplica al resto de la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"UTEC\",\n  \"email\": \"profe@utec.edu.pe\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('200 y token presente', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(d).to.have.property('token');",
                  "});",
                  "// El tenant y el rol los decide el token, no el cliente:",
                  "// se guardan para que el resto de la coleccion los use.",
                  "pm.collectionVariables.set('token', d.token);",
                  "pm.collectionVariables.set('tenantActual', d.usuario.tenant_id);",
                  "pm.collectionVariables.set('rolActual', d.usuario.rol);",
                  "pm.collectionVariables.set('userId', d.usuario.user_id);",
                  "console.log('sesion:', d.usuario.tenant_id, d.usuario.rol, d.usuario.nombre);"
                ]
              }
            }
          ]
        },
